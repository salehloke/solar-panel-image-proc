# Database Configuration
DATABASE_URL=postgresql+asyncpg://solarai:solarai123@postgres:5432/solarai
POSTGRES_PASSWORD=solarai123

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=30

# Model Configuration
MODEL_PATH=/app/models
MODEL_LOADING_MODE=volume  # Options: volume, build_time, runtime
MODEL_NAME=resnet18_solar_panel.pt
MODEL_DOWNLOAD_URL=https://download.pytorch.org/models/resnet18-5c106cde.pth
MODEL_SAVE_PATH=/app/models/resnet18_solar_panel.pt
MODEL_CACHE_DIR=/home/appuser/.cache/torch/hub

# Logging
LOG_LEVEL=INFO

# pgAdmin Configuration (Optional)
PGADMIN_PASSWORD=admin123

# Application Configuration
DEBUG=True

# Redis Configuration
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Development Configuration
RELOAD=True
HOST=0.0.0.0
PORT=8000 